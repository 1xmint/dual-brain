modules = ["nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"


# Persistence + Dual-Brain auto-launch
[env]
GH_CONFIG_DIR = "/home/runner/workspace/.replit-tools/.gh-persistent"

# Persistence + Dual-Brain auto-launch
onBoot = """
source /home/runner/workspace/.replit-tools/scripts/setup-claude-code.sh 2>/dev/null || true
ln -sf /home/runner/workspace/.replit-tools/.npm-persistent/.npmrc ~/.npmrc 2>/dev/null || true
export GH_CONFIG_DIR=/home/runner/workspace/.replit-tools/.gh-persistent
gh auth setup-git 2>/dev/null || true
git config --global credential.\"https://github.com\".helper '!GH_CONFIG_DIR=/home/runner/workspace/.replit-tools/.gh-persistent gh auth git-credential' 2>/dev/null || true
npm install -g dual-brain 2>/dev/null || true
dual-brain install --global 2>/dev/null || true
"""
